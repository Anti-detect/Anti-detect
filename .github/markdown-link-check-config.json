{
  "aliveStatusCodes": [200, 206, 403],
  "ignorePatterns": [
    { "pattern": "^mailto:" },
    { "pattern": "github\\.com/.*/(issues|pull)" },
    { "pattern": "img\\.shields\\.io" },
    { "pattern": "github\\.com/.*/actions/workflows" },
    { "pattern": "contributor-covenant\\.org" },
    { "pattern": "help\\.multilogin\\.com" },
    { "pattern": "documenter\\.getpostman\\.com" },
    { "pattern": "multilogin\\.com/(en|help|support)" },
    { "pattern": "github\\.com/Anti-detect/Anti-detect/security/advisories" }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3
}
