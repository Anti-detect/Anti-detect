# Multilogin X — Local Launcher API (from docs/multilogin-api/spec/)
MLX_LAUNCHER_HOST=launcher.mlx.yt
MLX_LAUNCHER_PORT=45001

# Profile identifiers (replace with your folder/profile UUIDs)
MLX_FOLDER_ID=your-folder-uuid
MLX_PROFILE_ID=your-profile-uuid

# Start profile query params
MLX_AUTOMATION_TYPE=puppeteer
MLX_HEADLESS=false

# Cloud API (sign-in, refresh token, profile management)
MLX_CLOUD_BASE=https://api.multilogin.com
MLX_BEARER_TOKEN=
