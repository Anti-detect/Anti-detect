# Multilogin X — Local Launcher API (from docs/multilogin-api/spec/)
MLX_LAUNCHER_HOST=launcher.mlx.yt
MLX_LAUNCHER_PORT=45001

# Profile identifiers (replace with your folder/profile UUIDs)
MLX_FOLDER_ID=your-folder-uuid
MLX_PROFILE_ID=your-profile-uuid

# Start profile query params
MLX_AUTOMATION_TYPE=puppeteer
MLX_HEADLESS=false

# Recipes — optional
MLX_SMOKE_URL=https://example.com
MLX_ROTATION_DELAY_SEC=3
MLX_PROFILES_JSON=sdk/python/recipes/profiles.json

# Recipe 07 — login flow (never commit real passwords)
MLX_LOGIN_USER=
MLX_LOGIN_PASS=
MLX_LOGIN_CONFIG=sdk/python/recipes/login.example.json
MLX_LOGIN_URL=https://your-app.example/login
MLX_LOGIN_USER_SELECTOR=#email
MLX_LOGIN_PASS_SELECTOR=#password
MLX_LOGIN_SUBMIT_SELECTOR=button[type='submit']
MLX_LOGIN_SUCCESS_URL_CONTAINS=/dashboard

# Recipe 04 — optional Playwright attach per profile (else sleep placeholder)
MLX_USE_PLAYWRIGHT=false

# Recipe 06 — retry on start
MLX_RETRY_ATTEMPTS=3
MLX_RETRY_DELAY_SEC=2

# Recipe 09 — cookie warm / export
MLX_WARM_URLS=https://example.com
MLX_WARM_URLS_JSON=sdk/python/recipes/warm-urls.example.json
MLX_COOKIES_OUT=cookies_export.json

# Recipe 11 — cookie import
MLX_COOKIES_IN=cookies_export.json

# Recipe 10 — scrape snapshot
MLX_SCRAPE_URL=https://example.com
MLX_SCRAPE_SELECTOR=body
MLX_SCRAPE_OUT=scrape_snapshot.json

# Quick profile v3 proxy (recipe 03)
MLX_PROXY_HOST=
MLX_PROXY_PORT=
MLX_PROXY_TYPE=http
MLX_PROXY_USER=
MLX_PROXY_PASS=

# Cloud API (sign-in, refresh token, profile management)
MLX_CLOUD_BASE=https://api.multilogin.com
MLX_BEARER_TOKEN=

# Recipe 12 — cloud profile search / export
MLX_SEARCH_LIMIT=100
MLX_SEARCH_OFFSET=0
MLX_SEARCH_TEXT=
# MLX_SEARCH_FOLDER=1   # uncomment to filter by MLX_FOLDER_ID

# Recipe 12 — worker sharding (one worker per machine)
MLX_WORKER_ID=0
MLX_WORKER_COUNT=1
